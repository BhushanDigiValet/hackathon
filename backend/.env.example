PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=wynn_stay
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# cli = run the local Claude Code CLI (`claude -p`, uses its own login, no API key)
# api = call api.anthropic.com with ANTHROPIC_API_KEY
LLM_PROVIDER=cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_MS=90000

# AI Video Generation Service Configuration
# Supported providers: local, gemini, luma, pixverse, runway, pika, mock
# 'local' needs no API key: it renders the memory reel as an MP4 from the
# itinerary (served at /reels/*.mp4). Keyed providers fall back to 'local'
# when VIDEO_PROVIDER_API_KEY is empty.
VIDEO_PROVIDER=local
# Origin used in returned video URLs (defaults to http://localhost:$PORT)
VIDEO_PUBLIC_BASE_URL=
VIDEO_PROVIDER_API_KEY=
PIXVERSE_API_KEY=
GEMINI_API_KEY=
VIDEO_PROVIDER_BASE_URL=
